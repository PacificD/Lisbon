{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "@lisbon/shared/*": ["packages/shared/src/*"],
      "@lisbon/core/*": ["packages/core/src/*"],
      "@lisbon/workflows/*": ["packages/workflows/src/*"],
      "@lisbon/email/*": ["packages/email/src/*"],
      "@lisbon/db/*": ["packages/db/src/*"]
    }
  }
}
